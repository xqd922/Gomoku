<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.gomoku" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/gomoku_background</item>
        <item name="android:statusBarColor">@color/gomoku_background</item>
        <item name="android:navigationBarColor">@color/gomoku_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:colorAccent">@color/gomoku_accent</item>
        <item name="android:forceDarkAllowed">false</item>
    </style>
</resources>
